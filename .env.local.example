# Supabase project credentials (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Used by the admin dashboard and server actions that need to
# bypass RLS (e.g. reading every participant). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Simple shared password gate for the admin dashboard.
ADMIN_DASHBOARD_PASSWORD=change-me

# Base URL used to build shareable links (e.g. https://failsafe.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe: subscription billing + off-session stake capture on failure.
# STRIPE_WEBHOOK_SECRET comes from the CLI (`stripe listen`) or the
# webhook endpoint's settings in the Stripe dashboard.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ParityDeals (or a comparable PPP pricing tool): resolves a localized
# subscription price per country. Leave unset to always charge the base
# SEK price.
PARITYDEALS_API_KEY=
PARITYDEALS_PRODUCT_ID=

# VPN/proxy detection to stop users from spoofing a cheaper country. No
# specific vendor is wired in — point these at whichever detection API you
# use; leave unset to skip the check (fails open, not closed).
VPN_DETECTION_API_URL=
VPN_DETECTION_API_KEY=

# Tremendous: category-locked gift card delivery on challenge failure.
# TREMENDOUS_API_BASE defaults to their sandbox (testflight) API — point it
# at https://www.tremendous.com/api/v2 for real deliveries.
TREMENDOUS_API_KEY=
TREMENDOUS_FUNDING_SOURCE_ID=
TREMENDOUS_API_BASE=
# One Tremendous catalog product ID per experience type — must be a
# category-locked product (a specific restaurant/event/travel brand), never
# their general-purpose flexible/Visa reward.
TREMENDOUS_PRODUCT_DINNER=
TREMENDOUS_PRODUCT_TICKETS_EVENT=
TREMENDOUS_PRODUCT_TRIP=
TREMENDOUS_PRODUCT_ACTIVITY=
TREMENDOUS_PRODUCT_OTHER=
